#!/bin/sh
# tsem - GL.iNet Tailscale Exit Manager. THE one controller: the hardware
# switch hook, Home Assistant (tsem-mqtt), the procd daemon and the CLI all
# call this program; nothing else touches firewall rules or tailscale.
#
#   tsem set direct|german [--source NAME] [--no-wait]   record a USER action (last action wins)
#   tsem failover auto|off|now                           failover policy / manual failover
#   tsem status [--json]                                 read-only
#   tsem tick                                            one probe/failover/reconcile iteration
#   tsem daemon                                          loop of tick (run by procd)
#   tsem boot                                            fail-closed state at boot, no probes
#   tsem reapply                                         re-assert the guard (fw reload / hotplug)
#   tsem teardown                                        remove ALL tsem rules (uninstall only)
#   tsem verify-nodes                                    read-only: are the configured exit nodes the intended, approved, online nodes?
#   tsem config get [--json] | set KEY=VALUE...          exit nodes and auto-return (validated, atomic; the only config writer for GUI/API)
#   tsem egress [--json] [--refresh]                     public address seen from outside (asks myip.wtf, on demand)
#   tsem nodes [--json]                                  read-only: exit-capable tailnet peers and their role
#   tsem deps                                            reinstall packages setup installed and a firmware upgrade removed (needs Internet)
#   tsem interval                                        read-only: the daemon's current polling interval and why
#   tsem diag | selftest                                 read-only diagnostics
#
# Safety rules implemented here:
#  - closing before opening: the guard is closed BEFORE the exit node changes
#    and opened (german) only after the exit node passed egress checks
#  - DIRECT: exit node is cleared first, the guard is opened last
#  - missing/corrupt intent, backend errors => BLOCKED, never DIRECT
#  - only `set` / `failover auto|off` write the intent; status/tick/boot/reapply never do
#  - probes run outside the lock, so `set` is never blocked by a slow probe; a user
#    action that happened during probing discards the probe results (user wins)

set -u
# Callers (the web server bridge, hotplug, cron) may run without a PATH: GNU timeout then cannot find tailscale, iptables or ip.
PATH=${PATH:+$PATH:}/usr/sbin:/usr/bin:/sbin:/bin; export PATH
TSEM_LIBDIR=${TSEM_LIBDIR:-/usr/lib/tsem}
# shellcheck disable=SC1091
. "$TSEM_LIBDIR/common.sh"
# shellcheck disable=SC1091
. "$TSEM_LIBDIR/conf.sh"
# shellcheck disable=SC1091
. "$TSEM_LIBDIR/state.sh"
# shellcheck disable=SC1091
. "$TSEM_LIBDIR/failover.sh"
# shellcheck disable=SC1091
. "$TSEM_LIBDIR/backend.sh"

conf_load
backend_load

node_of() {
	case $1 in
	primary) echo "$TSEM_PRIMARY" ;;
	secondary) echo "$TSEM_SECONDARY" ;;
	esac
}

name_of() {
	case $1 in
	primary) echo "$TSEM_PRIMARY_NAME" ;;
	secondary) echo "$TSEM_SECONDARY_NAME" ;;
	esac
}

# converge GUARD NODE_IP|''   (caller holds the lock). Never leaves a window.
converge() {
	_cw=$1 _cn=$2
	if [ "$_cw" = german ] && [ -z "$_cn" ]; then _cw=blocked; fi
	_cg=$(be_guard_get)
	if [ "$_cw" = open ]; then
		_ce=$(be_exit_get)
		case $_ce in
		none | unavailable) ;;
		*)
			# A user action clears any exit node; periodic reconcile only clears OUR nodes
			# (never a node the user picked by hand in DIRECT mode).
			if [ "${CONVERGE_CLEAR_ALL:-0}" != 1 ] && [ "$_ce" != "$TSEM_PRIMARY" ] && [ "$_ce" != "$TSEM_SECONDARY" ]; then
				be_guard_set open
				return
			fi
			if ! be_exit_set none; then
				case $(be_exit_get) in
				none | unavailable) ;;
				*) log "cannot clear exit node; guard stays as it is"; return 1 ;;
				esac
			fi
			;;
		esac
		be_guard_set open
		return
	fi
	case $_cg in
	blocked) ;;
	german)
		if [ "$_cw" = blocked ]; then be_guard_set blocked || return 1; _cg=blocked; fi ;;
	*) be_guard_set blocked || return 1; _cg=blocked ;;
	esac
	# F01/F02: BLOCKED means "no usable exit node". A leftover exit node keeps tailscale's default route
	# in table 52 alive, and the router-own chain (TSEM_OUT) lets everything through tailscale0, so the
	# router itself could still reach the Internet (through the tunnel of a node we declared unusable).
	# The guard is already closed here (closing before clearing), now the node is removed as well.
	if [ -z "$_cn" ] && [ "$_cw" = blocked ]; then
		case $(be_exit_get) in
		none | unavailable) ;;
		*)
			log "BLOCKED: clearing the exit node (no usable node; router-own traffic must not use the tunnel default route)"
			be_exit_set none || log "BLOCKED: clearing the exit node failed"
			case $(be_exit_get) in
			none | unavailable) ;;
			*) log "BLOCKED: exit node still set after clearing; guard stays blocked"; return 1 ;;
			esac
			;;
		esac
	fi
	if [ -n "$_cn" ]; then
		_ce=$(be_exit_get)
		if [ "$_ce" != "$_cn" ]; then
			[ "$_cg" = blocked ] || { be_guard_set blocked || return 1; _cg=blocked; }
			be_exit_set "$_cn" || { log "setting exit node $_cn failed; guard stays blocked"; return 1; }
		fi
	fi
	[ "$_cg" = "$_cw" ] || be_guard_set "$_cw" || return 1
	# drift inside the same state (e.g. hook lost): re-apply
	[ "$(be_guard_get)" = "$_cw" ] || be_guard_set "$_cw"
}

# ----------------------------------------------------------------- tick

# _note KEY TEXT: log a probe verdict only when it changed since the last round (no log flood at
# 5 s intervals), so the reason a node was rejected is visible in logread afterwards.
_note() {
	mkdir -p "$TSEM_RUN_DIR" 2>/dev/null
	[ "$(cat "$TSEM_RUN_DIR/note.$1" 2>/dev/null)" = "$2" ] && return 0
	printf '%s\n' "$2" >"$TSEM_RUN_DIR/note.$1" 2>/dev/null
	log "probe $1: $2"
}

# PR_KP/PR_KS say WHAT the ok/fail of a node rests on (they are different evidence):
#   egress       real Internet fetch through the selected exit node worked
#   egress-fail  the selected exit node is applied but the fetch failed
#   reach        not selected: it only answers tailscale ping (this is NOT egress)
#   unreachable  not selected and does not answer
#   rejected     identity / online / exit-node approval does not match the configuration
#   pending      selected but the exit node is not applied (yet): no signal
_probe_round() { # needs _pr_cur; sets SIG_P SIG_S PR_KP PR_KS PR_DNS
	SIG_P=0 SIG_S=0 PR_DNS=skip PR_KP=unknown PR_KS=unknown
	# One `tailscale status` per round identifies the nodes. A node whose name/IP/exit-node
	# approval does not match the configuration is NEVER usable (no automatic fallback to
	# "whatever is at that IP"), even if it answers.
	if [ -n "$TSEM_PRIMARY_NAME$TSEM_SECONDARY_NAME" ]; then be_nodes_scan >/dev/null 2>&1 || true; fi
	for _pn in primary secondary; do
		_pip=$(node_of "$_pn")
		_ps=0 _pk=unknown
		if [ -n "$_pip" ] && ! be_node_check "$(name_of "$_pn")" "$_pip"; then
			_ps=0 _pk=rejected
			_note "$_pn" "rejected: $(be_node_why "$(name_of "$_pn")" "$_pip" 2>/dev/null)"
		elif [ -n "$_pip" ]; then
			if [ "$_pn" = "$_pr_cur" ]; then
				if [ "$(be_exit_get)" != "$_pip" ]; then _ps=2 _pk=pending; _note "$_pn" "exit node not applied yet" # no signal
				elif be_probe_egress; then _ps=1 _pk=egress; _note "$_pn" "egress ok ($(be_probe_detail))"
				else _pk=egress-fail; _note "$_pn" "egress FAILED through exit node $_pip: $(be_probe_detail)"; fi
			else
				if be_probe_reach "$_pip"; then _ps=1 _pk=reach; _note "$_pn" "reachable, not selected (tailscale ping only, no egress proof)"
				else _pk=unreachable; _note "$_pn" "not reachable (tailscale ping failed 3x)"; fi
			fi
		fi
		if [ "$_pn" = primary ]; then SIG_P=$_ps PR_KP=$_pk; else SIG_S=$_ps PR_KS=$_pk; fi
	done
	if [ "$_pr_cur" != none ] && [ -n "$TSEM_DNS_PROBE_HOST" ]; then
		if be_probe_dns; then PR_DNS=ok; else PR_DNS=fail; fi
	fi
}

cmd_tick() {
	_tk_force=${1:-0}
	FO_FORCE_REFUSED=0
	lock_acquire
	intent_read
	_irc=$?
	_seq0=$I_SEQ _mode=$I_MODE _fom=$I_FAILOVER
	fo_load
	_pr_cur=$FO_CUR
	lock_release

	if [ "$_irc" -ne 0 ]; then
		log "intent missing/invalid: fail closed (BLOCKED)"
		lock_acquire
		be_guard_set blocked
		_rc=$?
		lock_release
		return "$_rc"
	fi

	if [ "$_mode" = direct ]; then
		lock_acquire
		intent_read
		if [ "$I_SEQ" = "$_seq0" ]; then
			fo_reset
			FO_CHK=$(now)
			if converge open ''; then FO_ERR=''; else FO_ERR='direct apply failed'; fi
			fo_save
			_rc=0
			[ -z "$FO_ERR" ] || _rc=1
		else
			_rc=0
		fi
		lock_release
		return "$_rc"
	fi

	if [ "$_mode" = blocked ]; then
		# explicit BLOCKED: hold the closed guard, no probes, no exit node, never DIRECT
		lock_acquire
		intent_read
		if [ "$I_SEQ" = "$_seq0" ]; then
			fo_reset
			FO_CHK=$(now)
			if converge blocked ''; then FO_ERR=''; else FO_ERR='blocked apply failed'; be_guard_set blocked || log "CRITICAL: cannot even enforce the blocked guard"; fi
			fo_save
			_rc=0
			[ -z "$FO_ERR" ] || _rc=1
		else
			_rc=0
		fi
		lock_release
		return "$_rc"
	fi

	_probe_round # outside the lock

	lock_acquire
	intent_read
	if [ $? -ne 0 ] || [ "$I_SEQ" != "$_seq0" ]; then
		lock_release
		return 0 # user action during probing wins; next tick starts from the new intent
	fi
	fo_load
	if [ "$FO_CUR" != "$_pr_cur" ]; then lock_release; return 0; fi
	NOW=$(now)
	FO_FAILOVER_MODE=$_fom FORCE=$_tk_force
	_old=$(fo_state_name german)
	fo_step
	FO_PS=fail FO_SS=fail FO_PK=$PR_KP FO_SK=$PR_KS
	[ "$SIG_P" = 1 ] && FO_PS=ok
	[ "$SIG_S" = 1 ] && FO_SS=ok
	FO_DNS=$PR_DNS FO_CHK=$NOW
	[ "$FO_VER" = 1 ] || FO_DNS=skip
	_new=$(fo_state_name german)
	[ "$_old" = "$_new" ] || log "state $_old -> $_new"
	_want=$(fo_guard_for "$_new")
	_node=$(node_of "$FO_CUR")
	_rc=0
	FO_ERR=''
	if ! converge "$_want" "$_node"; then
		FO_ERR='apply failed'
		_rc=1
		be_guard_set blocked || log "CRITICAL: cannot even enforce the blocked guard"
	fi
	fo_save
	lock_release
	[ "$FO_FORCE_REFUSED" = 0 ] || return 4
	return "$_rc"
}

# ----------------------------------------------------------------- set

_wait_active() {
	_wi=0
	_wmax=$((TSEM_UP_N * 2 + 2))
	while [ "$_wi" -lt "$_wmax" ]; do
		cmd_tick || true
		fo_load
		case $(fo_state_name german) in PRIMARY_ACTIVE | SECONDARY_ACTIVE | DEGRADED) return 0 ;; esac
		_wi=$((_wi + 1))
		[ "$TSEM_SET_TICK_DELAY" -eq 0 ] || sleep "$TSEM_SET_TICK_DELAY"
	done
	return 0
}

cmd_set() {
	[ $# -ge 1 ] || die "usage: tsem set direct|exit|blocked (exit = german) [--source NAME] [--no-wait]"
	_mode=$1
	[ "$_mode" != exit ] || _mode=german
	shift
	_src=cli _wait=$TSEM_SET_TICKS
	while [ $# -gt 0 ]; do
		case $1 in
		--source)
			[ $# -ge 2 ] || die "--source needs a value"
			_src=$2
			shift 2
			;;
		--no-wait) _wait=0; shift ;;
		*) die "unknown option: $1" ;;
		esac
	done
	case $_mode in direct | german | blocked) ;; *) die "invalid mode: $_mode" ;; esac
	case $_src in '' | *[!a-z0-9_-]*) die "invalid source name" ;; esac
	if [ "$_mode" = german ] && [ -z "$TSEM_PRIMARY" ]; then
		DIE_RC=2 die "TSEM_PRIMARY (primary exit node) is not configured"
	fi

	lock_acquire
	intent_read
	_irc=$?
	_fo=auto
	[ "$_irc" -ne 0 ] || _fo=$I_FAILOVER
	_changed=0 _rc=0
	if [ "$_irc" -eq 0 ] && [ "$I_MODE" = "$_mode" ]; then
		log "already in $_mode (no change)"
	else
		intent_write "$_mode" "$_fo" "$_src" || die "cannot write intent"
		_changed=1
		fo_reset
		case $_mode in
		direct) CONVERGE_CLEAR_ALL=1; converge open '' || _rc=1; CONVERGE_CLEAR_ALL=0 ;;
		german | blocked) converge blocked '' || _rc=1 ;;
		esac
		FO_ERR=''
		[ "$_rc" -eq 0 ] || FO_ERR='apply failed'
		fo_save
	fi
	lock_release
	# every mode request is traceable: who asked (source), what, whether it changed anything, and how the apply ended
	log "set $_mode requested by source=$_src changed=$_changed apply_rc=$_rc wait=$_wait"

	if [ "$_mode" = german ] && [ "$_changed" -eq 1 ] && [ "$_wait" -eq 1 ]; then
		_wait_active
	fi
	return "$_rc"
}

cmd_failover() {
	case ${1:-} in
	auto | off)
		_fsrc=cli
		[ "${2:-}" = --source ] && _fsrc=${3:-cli}
		case $_fsrc in '' | *[!a-z0-9_-]*) die "invalid source name" ;; esac
		lock_acquire
		intent_read
		_irc=$?
		[ "$_irc" -eq 0 ] || { lock_release; die "no valid intent; run 'tsem set' first"; }
		if [ "$I_FAILOVER" = "$1" ]; then
			log "failover already $1 (no change)"
		else
			intent_write "$I_MODE" "$1" "$_fsrc" || { lock_release; die "cannot write intent"; }
		fi
		lock_release
		;;
	now)
		lock_acquire; intent_read; _irc=$?; _m=$I_MODE; lock_release
		[ "$_irc" -eq 0 ] && [ "$_m" = german ] || die "failover now needs mode german"
		cmd_tick 1
		_r=$?
		[ "$_r" -ne 4 ] || die "failover refused: the other node is not available"
		return "$_r"
		;;
	*) die "usage: tsem failover auto|off|now" ;;
	esac
}

# ----------------------------------------------------------- boot/reapply

cmd_boot() {
	lock_acquire
	intent_read
	_irc=$?
	fo_reset
	if [ "$_irc" -eq 0 ] && [ "$I_MODE" = direct ]; then
		be_guard_set open
		_rc=$?
	else
		# german, or missing/corrupt intent: closed until a node is verified.
		be_guard_set blocked
		_rc=$?
	fi
	if [ "$_rc" -ne 0 ]; then
		# The protection could not be installed: the exit mode must NOT look functional.
		# status shows ERROR + leak_risk until a later apply (daemon tick, hotplug, fw include) succeeds.
		FO_ERR='boot: protection not installed'
		fo_save
		log "CRITICAL: boot could not install the protection (layer 1 may still be active; see 'tsem diag')"
	else
		rm -f "$TSEM_RUN_DIR/boot_failed"
	fi
	lock_release
	return "$_rc"
}

# Re-assert the current desired guard WITHOUT probes and WITHOUT touching tailscale.
# deps: /etc/tsem/deps lists the packages setup installed with opkg (ip6tables-nft ...). A firmware upgrade removes them, and
# without ip6tables a protected mode cannot be built. This waits for the Internet, reinstalls what is missing and re-asserts the
# guard. Started in the background by the init script; safe to run by hand and to run twice (a lock keeps one copy).
cmd_deps() {
	_dp=${TSEM_DEPS_FILE:-/etc/tsem/deps}
	_opk=${TSEM_OPKG:-opkg}
	[ -s "$_dp" ] || return 0
	command -v "$_opk" >/dev/null 2>&1 || return 0
	_dm=''
	while IFS= read -r _pk; do
		[ -n "$_pk" ] || continue
		"$_opk" status "$_pk" 2>/dev/null | grep -q '^Status:.* installed' || _dm="$_dm $_pk"
	done <"$_dp"
	[ -n "$_dm" ] || return 0
	mkdir -p "$TSEM_RUN_DIR" 2>/dev/null
	mkdir "$TSEM_RUN_DIR/deps.lock" 2>/dev/null || return 0
	_dn=0
	while [ "$_dn" -lt "${TSEM_DEPS_TRIES:-60}" ]; do
		log "packages missing (firmware upgrade?):$_dm: waiting for the Internet to reinstall them"
		if "$_opk" update >/dev/null 2>&1; then
			# shellcheck disable=SC2086
			if "$_opk" install $_dm >/dev/null 2>&1; then
				log "reinstalled:$_dm"
				rmdir "$TSEM_RUN_DIR/deps.lock" 2>/dev/null
				cmd_reapply
				return 0
			fi
		fi
		_dn=$((_dn + 1))
		sleep "${TSEM_DEPS_DELAY:-15}"
	done
	log "could not reinstall:$_dm (no Internet or the package is not available): protected modes stay unavailable until it is"
	rmdir "$TSEM_RUN_DIR/deps.lock" 2>/dev/null
	return 1
}

cmd_reapply() {
	lock_acquire
	intent_read
	_irc=$?
	fo_load
	if [ "$_irc" -ne 0 ]; then
		_want=blocked
	elif [ "$I_MODE" = direct ]; then
		_want=open
	elif [ "$I_MODE" = blocked ]; then
		_want=blocked
	else
		_want=$(fo_guard_for "$(fo_state_name german)")
	fi
	be_guard_set "$_want"
	_rc=$?
	[ "$_rc" -ne 0 ] || rm -f "$TSEM_RUN_DIR/boot_failed"
	lock_release
	return "$_rc"
}

# ---------------------------------------------------------------- status

cmd_status() {
	_json=0
	[ "${1:-}" = "--json" ] && _json=1
	intent_read
	_irc=$?
	case $_irc in 0) _intent=ok ;; 1) _intent=missing ;; *) _intent=invalid ;; esac
	fo_load
	_desired=${I_MODE:-none}
	if [ "$_irc" -ne 0 ]; then _state=BLOCKED
	else _state=$(fo_state_name "$I_MODE"); fi
	_gwant=$(fo_guard_for "$_state")
	_guard=$(be_guard_get)
	_exit=$(be_exit_get | tr -cd 'A-Za-z0-9.:_-')
	case $_guard in german | blocked) _ks=true ;; *) _ks=false ;; esac
	_leak=false
	_bootfail=no; [ -e "$TSEM_RUN_DIR/boot_failed" ] && _bootfail=yes
	if [ "$_gwant" != open ]; then
		case $_guard in german | blocked) ;; *) _leak=true ;; esac
	fi
	[ "$_bootfail" = yes ] && [ "$_gwant" != open ] && _leak=true
	_active=none
	case $_state in PRIMARY_ACTIVE | SECONDARY_ACTIVE | DEGRADED) _active=$(node_of "$FO_CUR") ;; esac
	_aname=none
	case $_state in PRIMARY_ACTIVE | SECONDARY_ACTIVE | DEGRADED) _aname=$(name_of "$FO_CUR" | tr -cd "A-Za-z0-9._-"); [ -n "$_aname" ] || _aname=none ;; esac
	_pname=$(printf %s "$TSEM_PRIMARY_NAME" | tr -cd "A-Za-z0-9._-"); [ -n "$_pname" ] || _pname=none
	_sname=$(printf %s "$TSEM_SECONDARY_NAME" | tr -cd "A-Za-z0-9._-"); [ -n "$_sname" ] || _sname=none
	_hw=unknown _hwm=unknown _hws=none _hwt=0
	# Sources of the switch position, strongest first (F04). Only gpio and file READ the position; event and
	# persisted only REMEMBER what the firmware reported to the hook (the switch may have moved while the router was off).
	#   gpio       TSEM_HW_GPIO_VALUE (a sysfs value file) with TSEM_HW_GPIO_ON = the value meaning "on"/GERMAN
	#   file       TSEM_HW_STATE_FILE (first word on|off|1|0|german|direct)
	#   event      last event reported to the hook since this boot (tmpfs)
	#   persisted  last event before this boot (flash); shown, but marked as possibly outdated
	#   none       unknown: shown as unknown, never guessed
	if [ -n "$TSEM_HW_GPIO_VALUE" ] && [ -r "$TSEM_HW_GPIO_VALUE" ]; then
		case $(head -n 1 "$TSEM_HW_GPIO_VALUE" 2>/dev/null | tr -d ' \r\n') in
		"$TSEM_HW_GPIO_ON") _hw=on _hws=gpio ;;
		0 | 1) _hw=off _hws=gpio ;;
		esac
	fi
	if [ "$_hw" = unknown ] && [ -n "$TSEM_HW_STATE_FILE" ] && [ -r "$TSEM_HW_STATE_FILE" ]; then
		case $(head -n 1 "$TSEM_HW_STATE_FILE" 2>/dev/null | tr -d ' \r\n' | tr 'A-Z' 'a-z') in
		on | 1 | german) _hw=on _hws=file ;;
		off | 0 | direct) _hw=off _hws=file ;;
		esac
	fi
	if [ "$_hw" = unknown ] && [ -r "$TSEM_RUN_DIR/hw_event" ]; then
		# last position the firmware reported to the hook since boot (not a reading of the physical switch)
		_hwe=''
		read -r _hwt _hwe <"$TSEM_RUN_DIR/hw_event" 2>/dev/null
		is_epoch "$_hwt" || _hwt=0
		case $_hwe in on) _hw=on _hws=event ;; off) _hw=off _hws=event ;; esac
	fi
	if [ "$_hw" = unknown ] && [ -r "$TSEM_STATE_DIR/hw_last" ]; then
		# survives a reboot (flash); written by the hook with the boot id it ran in. A position remembered from BEFORE
		# this boot is reported as `persisted`, never as `event`, so a GUI can say "last known, may be outdated".
		_hwe='' _hwb=''
		read -r _hwt _hwe _hwb <"$TSEM_STATE_DIR/hw_last" 2>/dev/null
		is_epoch "$_hwt" || _hwt=0
		case $_hwe in on) _hw=on _hws=persisted ;; off) _hw=off _hws=persisted ;; esac
	fi
	if [ "$_hw" != unknown ]; then
		if [ "$_hw" != unknown ] && [ "$_irc" -eq 0 ]; then
			if { [ "$_hw" = on ] && [ "$I_MODE" = german ]; } || { [ "$_hw" = off ] && [ "$I_MODE" = direct ]; }; then _hwm=yes; else _hwm=no; fi
		fi
	fi
	_p=${TSEM_PRIMARY:-none} _s=${TSEM_SECONDARY:-none}
	# protection claims only from the verified guard (be_guard_get checks IPv4 AND IPv6 and the DNS hook)
	case $_guard in german | blocked) _v6=guarded; _dnsr=none; [ -z "$TSEM_DNS_REDIRECT" ] || _dnsr=redirect ;; open) _v6=off; _dnsr=off ;; *) _v6=unverified; _dnsr=unverified ;; esac
	_ar=$([ "$TSEM_AUTO_RETURN" = 1 ] && echo true || echo false)
	# F06: why is a healthy primary not selected again yet? (the hysteresis is visible instead of looking stuck)
	#   none        nothing to wait for (primary active, or not running a failover)
	#   disabled    TSEM_AUTO_RETURN=0 or failover=off: the secondary stays until it fails
	#   successes:A/B,dwell:Ns,backoff:Ms   A of B consecutive primary successes seen, seconds of dwell and of backoff left
	#   primary_not_usable   all counters satisfied but the primary does not currently answer
	_rw=none
	if [ "$_irc" -eq 0 ] && [ "$I_MODE" = german ] && [ "$FO_CUR" = secondary ] && [ "$FO_VER" = 1 ]; then
		if [ "${TSEM_AUTO_RETURN:-1}" != 1 ] || [ "${I_FAILOVER:-auto}" != auto ]; then _rw=disabled
		else
			_rn=$(now)
			_rok=$((TSEM_RETURN_N - FO_OKP)); [ "$_rok" -gt 0 ] || _rok=0
			_rdw=$((TSEM_DWELL - (_rn - FO_LAST))); [ "$_rdw" -gt 0 ] || _rdw=0
			_rbo=$((FO_DEADP - _rn)); [ "$_rbo" -gt 0 ] || _rbo=0
			if [ "$_rok" -eq 0 ] && [ "$_rdw" -eq 0 ] && [ "$_rbo" -eq 0 ]; then _rw=primary_not_usable
			else _rw="successes:${FO_OKP}/${TSEM_RETURN_N},dwell:${_rdw}s,backoff:${_rbo}s"; fi
		fi
	fi
	if [ "$_json" -eq 1 ]; then
		printf '{"version":"%s","intent":"%s","intent_reason":"%s","mode":"%s","state":"%s","desired_guard":"%s","guard":"%s","kill_switch_active":%s,"leak_risk":%s,"exit_node":"%s","active_exit":"%s","primary":"%s","primary_ok":"%s","primary_probe":"%s","secondary":"%s","secondary_ok":"%s","secondary_probe":"%s","failover":"%s","dns":"%s","seq":%s,"source":"%s","last_check":%s,"error":"%s","boot_failed":"%s","hw_state":"%s","hw_match":"%s","auto_return":%s,"last_change":%s,"ipv6_protection":"%s","dns_protection":"%s","hw_source":"%s","hw_event_ts":%s,"return_wait":"%s","mode_label":"%s","active_exit_name":"%s","primary_name":"%s","secondary_name":"%s"}\n' \
			"$TSEM_VERSION" "$_intent" "$I_WHY" "$_desired" "$_state" "$_gwant" "$_guard" "$_ks" "$_leak" "$_exit" "$_active" \
			"$_p" "${FO_PS:-unknown}" "${FO_PK:-unknown}" "$_s" "${FO_SS:-unknown}" "${FO_SK:-unknown}" "${I_FAILOVER:-auto}" "$FO_DNS" "${I_SEQ:-0}" "${I_SRC:-}" \
			"$FO_CHK" "$FO_ERR" "$_bootfail" "$_hw" "$_hwm" "$_ar" "${I_TS:-0}" "$_v6" "$_dnsr" "$_hws" "${_hwt:-0}" "$_rw" "$TSEM_MODE_LABEL" "$_aname" "$_pname" "$_sname"
	else
		printf 'version=%s\nintent=%s\nintent_reason=%s\nmode=%s\nstate=%s\ndesired_guard=%s\nguard=%s\nkill_switch_active=%s\nleak_risk=%s\nexit_node=%s\nactive_exit=%s\nprimary=%s\nprimary_ok=%s\nprimary_probe=%s\nsecondary=%s\nsecondary_ok=%s\nsecondary_probe=%s\nfailover=%s\ndns=%s\nseq=%s\nsource=%s\nlast_check=%s\nerror=%s\nboot_failed=%s\nhw_state=%s\nhw_match=%s\nauto_return=%s\nlast_change=%s\nipv6_protection=%s\ndns_protection=%s\nhw_source=%s\nhw_event_ts=%s\nreturn_wait=%s\nmode_label=%s\nactive_exit_name=%s\nprimary_name=%s\nsecondary_name=%s\n' \
			"$TSEM_VERSION" "$_intent" "$I_WHY" "$_desired" "$_state" "$_gwant" "$_guard" "$_ks" "$_leak" "$_exit" "$_active" \
			"$_p" "${FO_PS:-unknown}" "${FO_PK:-unknown}" "$_s" "${FO_SS:-unknown}" "${FO_SK:-unknown}" "${I_FAILOVER:-auto}" "$FO_DNS" "${I_SEQ:-0}" "${I_SRC:-}" \
			"$FO_CHK" "$FO_ERR" "$_bootfail" "$_hw" "$_hwm" "$_ar" "${I_TS:-0}" "$_v6" "$_dnsr" "$_hws" "${_hwt:-0}" "$_rw" "$TSEM_MODE_LABEL" "$_aname" "$_pname" "$_sname"
	fi
	[ "$_leak" = false ]
}

# Read-only: why is the intent (in)valid? rc 0 valid, 1 missing, 2 invalid. Never writes, never applies.
cmd_intent_check() {
	intent_read
	_icrc=$?
	case $_icrc in 0) _icw=valid ;; 1) _icw=missing ;; *) _icw=invalid ;; esac
	echo "intent=$_icw reason=$I_WHY file=$TSEM_STATE_DIR/intent"
	if [ "$_icrc" -eq 0 ]; then echo "mode=$I_MODE failover=$I_FAILOVER seq=$I_SEQ source=$I_SRC"
	else echo "effective_state=BLOCKED (an unusable intent is never treated as DIRECT; repair with: tsem set direct|german)"; fi
	return "$_icrc"
}

# ----------------------------------------------------------- diag/selftest

cmd_diag() {
	echo "== tsem $TSEM_VERSION (read-only diagnostics)"
	echo "-- status"
	cmd_status || echo "(leak_risk reported)"
	echo "-- config (no secrets are stored in tsem.conf)"
	for _k in PRIMARY SECONDARY LAN_IFACES ALLOW_OUT_IFACES TS_IFACE TS_TABLE RT_GUARD RULE_PRIO TAILNET4 TAILNET6 \
		ALLOW_SUBNETS4 ALLOW_SUBNETS6 DNS_REDIRECT DNS_ROUTER PRIMARY_NAME SECONDARY_NAME OUT_GUARD OUT_LOCAL_IFACES ALLOW_NTP ALLOW_UNDERLAY_DNS UNDERLAY_MARK \
		INTERVAL INTERVAL_RECOVERY INTERVAL_STEADY INTERVAL_IDLE FAIL_N UP_N RETURN_N DWELL BACKOFF_MIN BACKOFF_MAX; do
		eval "printf 'TSEM_%s=%s\n' \"$_k\" \"\${TSEM_$_k:-}\""
	done
	echo "-- intent journal (last 10)"
	tail -n 10 "$TSEM_RUN_DIR/journal" 2>/dev/null || echo "(none)"
	if [ "${TSEM_BACKEND:-ipt}" = ipt ]; then
		echo "-- ip rule"
		ip rule show 2>&1 | head -n 30
		echo "-- ip -6 rule"
		ip -6 rule show 2>&1 | head -n 30
		echo "-- ip route show table $TSEM_TS_TABLE"
		ip route show table "$TSEM_TS_TABLE" 2>&1 | head -n 20
		echo "-- iptables FORWARD head / TSEM_FWD"
		iptables -w 5 -S FORWARD 2>&1 | head -n 6
		iptables -w 5 -S TSEM_FWD 2>&1 | head -n 20
		echo "-- iptables OUTPUT head / TSEM_OUT (router-own traffic)"
		iptables -w 5 -S OUTPUT 2>&1 | head -n 6
		iptables -w 5 -S TSEM_OUT 2>&1 | head -n 30
		echo "-- ip6tables TSEM_FWD / TSEM_OUT"
		ip6tables -w 5 -S TSEM_FWD 2>&1 | head -n 20
		ip6tables -w 5 -S TSEM_OUT 2>&1 | head -n 30
		echo "-- nat TSEM_DNS_OUT (router-own DNS redirect, F03)"
		iptables -w 5 -t nat -S TSEM_DNS_OUT 2>&1 | head -n 12
		echo "-- nat TSEM_DNS"
		iptables -w 5 -t nat -S TSEM_DNS 2>&1 | head -n 10
		echo "-- DNS evidence (meaning of resolver 0.0.0.0 must be verified here, not assumed)"
		for _f in /etc/resolv.conf /tmp/resolv.conf /tmp/resolv.conf.auto /tmp/resolv.conf.d/resolv.conf.auto; do
			[ -r "$_f" ] && { echo "[$_f]"; grep -v '^#' "$_f" | head -n 10; }
		done
		echo "[kernel route chosen for 0.0.0.0 / 127.0.0.1 (evidence, not assumption)]"
		ip route get 0.0.0.0 2>&1 | head -n 2
		ip route get 127.0.0.1 2>&1 | head -n 2
		echo "[classification of every resolver entry]"
		for _f in /etc/resolv.conf /tmp/resolv.conf.auto /tmp/resolv.conf.d/resolv.conf.auto; do
			[ -r "$_f" ] && sed -n 's/^nameserver[[:space:]]*\([^[:space:]]*\).*/\1/p' "$_f" | while IFS= read -r _ns; do echo "$_f: $_ns -> $(dns_class "$_ns")"; done
		done
		echo "[dnsmasq/AdGuard/other listeners on :53]"
		( netstat -lnup 2>/dev/null; netstat -lntp 2>/dev/null ) | grep ':53 ' | head -n 10
		echo "[uci dhcp.@dnsmasq[0] server/noresolv/resolvfile]"
		uci -q get dhcp.@dnsmasq[0].server 2>/dev/null
		uci -q get dhcp.@dnsmasq[0].noresolv 2>/dev/null
		uci -q get dhcp.@dnsmasq[0].resolvfile 2>/dev/null
		echo "-- tailscale (prefs summary, no keys)"
		_tsc status --json 2>/dev/null | grep -E '"(BackendState|ExitNodeStatus|Online)"' | head -n 5
		_tsc debug prefs 2>/dev/null | grep -E '"(ExitNodeID|ExitNodeIP|AdvertiseRoutes|CorpDNS|RouteAll)"' | head -n 8
	fi
}

# Classify a resolver address for the guard (no network access, string logic only).
# "unspecified" (0.0.0.0) is deliberately NOT interpreted: its effect on this device must be shown by
# `tsem diag` (ip route get) and the active acceptance test, not assumed.
dns_class() {
	case $1 in
	127.* | ::1) echo loopback ;;
	0.0.0.0 | ::) echo unspecified ;;
	10.* | 192.168.* | 169.254.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[0-1].* | fe80:* | fc* | fd*) echo private ;;
	100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) echo tailnet ;;
	'') echo empty ;;
	*) echo public ;;
	esac
}

# Evidence for resolver 0.0.0.0: the kernel's own answer. Only "local ... dev lo" proves the address stays on
# this host (no path to an external resolver). Any other answer, or an error, proves nothing -> not local.
dns_unspec_local() {
	_du=$(ip route get 0.0.0.0 2>/dev/null | head -n 1)
	case $_du in
	"local "*" dev lo "* | "local "*" dev lo") return 0 ;;
	esac
	return 1
}

_st_pass() { echo "PASS $1: $2"; }
_st_warn() { echo "WARN $1: $2"; _st_w=$((_st_w + 1)); }
_st_fail() { echo "FAIL $1: $2"; _st_f=$((_st_f + 1)); }

cmd_selftest() {
	_st_f=0 _st_w=0
	if [ "${TSEM_BACKEND:-ipt}" != ipt ]; then echo "selftest needs the ipt backend"; return 2; fi
	command -v flock >/dev/null 2>&1 && _st_pass flock present || _st_fail flock "missing (needed for the global lock)"
	command -v md5sum >/dev/null 2>&1 && _st_pass md5sum present || _st_fail md5sum missing
	command -v iptables >/dev/null 2>&1 && _st_pass iptables "$(iptables --version 2>&1 | head -n 1)" || _st_fail iptables missing
	iptables -w 1 -S >/dev/null 2>&1 && _st_pass iptables-wait "-w supported" || _st_fail iptables-wait "-w not supported"
	iptables-restore --help 2>&1 | grep -q -- '--noflush' && _st_pass iptables-restore "--noflush supported" || _st_fail iptables-restore "--noflush not found"
	iptables -m comment --help >/dev/null 2>&1 && _st_pass xt_comment available || _st_warn xt_comment "could not confirm"
	if [ -e /proc/net/if_inet6 ]; then
		command -v ip6tables >/dev/null 2>&1 && _st_pass ip6tables present || _st_fail ip6tables "IPv6 enabled but ip6tables missing"
	else _st_pass ipv6 "kernel IPv6 disabled"; fi
	ip rule help 2>&1 | grep -q suppress_prefixlength && _st_pass ip-rule "suppress_prefixlength supported" || _st_fail ip-rule "suppress_prefixlength unsupported (install ip-full or set TSEM_RT_GUARD=off)"
	# iproute2/busybox `ip rule help` usually does NOT list the actions, so grepping it proves nothing
	# (that was an RC2 false warning). Capability is proven when the guard is installed: tsem tries
	# prohibit, then unreachable, then blackhole (all drop, none routes) and VERIFIES the rule by reading it back.
	for _f in /etc/resolv.conf /tmp/resolv.conf.auto; do
		[ -r "$_f" ] || continue
		for _ns in $(sed -n 's/^nameserver[[:space:]]*\([^[:space:]]*\).*/\1/p' "$_f"); do
			case $(dns_class "$_ns") in
			loopback | tailnet) _st_pass "dns-resolver" "$_f: $_ns ($(dns_class "$_ns"))" ;;
			public) _st_pass "dns-resolver" "$_f: $_ns public: follows table 52/exit node in german mode; underlay DNS is rejected by TSEM_OUT" ;;
			unspecified) if dns_unspec_local; then _st_pass "dns-resolver" "$_f: $_ns (unspecified): the kernel routes it to the local host (dev lo), no path to an external resolver"
			else _st_warn "dns-resolver" "$_f: $_ns (unspecified address) could not be shown to be local; behaviour UNVERIFIED, see 'tsem diag' and the active DNS test of the acceptance run"; fi ;;
			private) _st_warn "dns-resolver" "$_f: $_ns (private): reachable only via WAN/LAN unless a subnet route exists; rejected from the router in german mode" ;;
			esac
		done
	done
	_fp=$(be_fastpath_state)
	case $_fp in
	none) _st_pass fastpath "no SFE/shortcut-fe module and no FLOWOFFLOAD rule" ;;
	*) _st_warn fastpath "$_fp: bypasses iptables/ip rules for established flows; tsem (TSEM_FASTPATH=$TSEM_FASTPATH) $([ "$TSEM_FASTPATH" = unload ] && echo 'removes the modules when the guard closes' || echo 'will report the guard inconsistent')" ;;
	esac
	if ip rule help 2>&1 | grep -q prohibit; then _st_pass ip-rule-deny "prohibit listed by ip rule help"
	else _st_pass ip-rule-deny "not listed by ip help (normal); fail-closed fallback prohibit>unreachable>blackhole, verified on install (TSEM_RT_DENY=$TSEM_RT_DENY)"; fi
	_tp=$(ip rule show 2>/dev/null | awk -v t="$TSEM_TS_TABLE" '$0 ~ ("lookup " t "$") { sub(":","",$1); print $1; exit }')
	if [ -z "$_tp" ]; then _st_warn tailscale-rule "no 'lookup $TSEM_TS_TABLE' rule (tailscaled stopped?)"
	elif [ "$_tp" -lt "$TSEM_RULE_PRIO" ]; then _st_pass rule-order "tailscale rule $_tp < guard rule $TSEM_RULE_PRIO"
	else _st_fail rule-order "tailscale rule $_tp >= guard $TSEM_RULE_PRIO: guard would shadow the tunnel (adjust TSEM_RULE_PRIO)"; fi
	command -v "${TSEM_TAILSCALE:-tailscale}" >/dev/null 2>&1 && _st_pass tailscale present || _st_fail tailscale missing
	_x=$(be_exit_get)
	case $_x in unavailable) _st_warn exit-get "tailscale status unavailable" ;; *) _st_pass exit-get "parsed '$_x'" ;; esac
	_tsc debug prefs 2>/dev/null | grep -q '"AdvertiseRoutes"' && {
		_tsc debug prefs 2>/dev/null | grep -q '0\.0\.0\.0/0' && _st_warn advertise-exit "router advertises itself as exit node; 'tailscale set --exit-node' may be refused"
	}
	if command -v curl >/dev/null 2>&1 || command -v uclient-fetch >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || [ -n "$TSEM_PROBE_CMD" ]; then
		_st_pass probe-tool "egress probe tool available"
	else _st_fail probe-tool "no curl/uclient-fetch/wget"; fi
	if timeout 1 true >/dev/null 2>&1 || timeout -t 1 true >/dev/null 2>&1; then _st_pass timeout "timeout applet works"
	else _st_warn timeout "no timeout applet"; fi
	[ -n "$TSEM_PRIMARY" ] && _st_pass primary "$TSEM_PRIMARY" || _st_fail primary "TSEM_PRIMARY not set"
	[ -n "$TSEM_SECONDARY" ] && _st_pass secondary "$TSEM_SECONDARY" || _st_warn secondary "TSEM_SECONDARY not set (no failover)"
	_vo=$(cmd_verify_nodes 2>&1) || true
	printf '%s\n' "$_vo" | while IFS= read -r _vl; do
		case $_vl in
		PASS*) echo "PASS nodes: ${_vl#PASS }" ;;
		WARN*) echo "WARN nodes: ${_vl#WARN }" ;;
		FAIL*) echo "FAIL nodes: ${_vl#FAIL }" ;;
		esac
	done
	case $_vo in *FAIL*) _st_f=$((_st_f + 1)) ;; esac
	if command -v iptables >/dev/null 2>&1; then
		iptables -m multiport --help >/dev/null 2>&1 && _st_pass xt_multiport available || _st_fail xt_multiport "missing: the router-egress guard needs it"
		iptables -m mark --help >/dev/null 2>&1 && _st_pass xt_mark available || _st_fail xt_mark "missing: the router-egress guard needs it"
	fi
	for _l in $TSEM_LAN_IFACES; do
		if [ -d "/sys/class/net/$_l" ] || ip link show dev "$_l" >/dev/null 2>&1; then _st_pass "iface-$_l" present; else _st_fail "iface-$_l" "not found"; fi
	done
	if [ -d "/sys/class/net/$TSEM_TS_IFACE" ] || ip link show dev "$TSEM_TS_IFACE" >/dev/null 2>&1; then _st_pass "iface-$TSEM_TS_IFACE" present; else _st_warn "iface-$TSEM_TS_IFACE" "not found (tailscaled stopped?)"; fi
	# F04: the hardware switch only reaches tsem if the firmware's handler runs OUR hook. The installed file must be the
	# tsem hook (marker line) and executable (GL's handler logs "can't be exec" otherwise). Which function the firmware
	# runs for the toggle button is a firmware setting: shown, and only warned about, never changed here.
	_hk=${TSEM_GL_SWITCH_DIR:-/etc/gl-switch.d}/tailscale-de.sh
	if [ -e "$_hk" ]; then
		if grep -q 'tsem-switch-hook' "$_hk" 2>/dev/null && [ -x "$_hk" ]; then
			_st_pass hw-hook "$_hk is the tsem hook and executable"
		else
			_st_fail hw-hook "$_hk exists but is not the (executable) tsem hook: switch events do not reach tsem (install.sh replaces it by default)"
		fi
		if command -v uci >/dev/null 2>&1; then
			_hf=$(uci -q get switch-button.@main[0].func 2>/dev/null)
			case $_hf in
			'') _st_warn hw-select "toggle-button function not readable via uci (switch-button.@main[0].func): select the custom function in the GL web UI (Toggle button) and check with the acceptance step hw.event" ;;
			tailscale-de | tailscale-de.sh) _st_pass hw-select "the firmware runs tailscale-de for the toggle button" ;;
			*) _st_warn hw-select "the firmware runs '$_hf' for the toggle button, not tailscale-de: the hook is never called (GL web UI: Toggle button)" ;;
			esac
		fi
	else
		# no hook installed. A router WITHOUT a hardware switch is a normal, supported setup (modes via GUI, CLI, Home Assistant).
		if [ -d "${TSEM_GL_SWITCH_DIR:-/etc/gl-switch.d}" ] || [ -e "${TSEM_SWITCH_CONF:-/etc/config/switch-button}" ]; then
			_st_warn hw-switch "the firmware supports a toggle button but the tsem hook is not installed: the switch does nothing (re-run install.sh without --keep-gl-hook), or ignore this if you do not use the switch"
		else
			_st_pass hw-switch "no hardware switch on this router (optional): the mode is set by the GUI, the CLI or Home Assistant"
		fi
	fi
	# F05: without the boot links nothing installs the kill switch after a reboot (RC5 hardware finding: no /etc/rc.d/S18tsem)
	_ini=${TSEM_INITD:-/etc/init.d} _rcd=${TSEM_RC_D:-/etc/rc.d}
	if [ -x "$_ini/tsem" ]; then
		if [ -x "$_rcd/S18tsem" ] && [ -x "$_rcd/K10tsem" ]; then
			_st_pass autostart "boot links S18tsem (before firewall and network) and K10tsem present: the intent is applied at every boot"
		else
			_st_fail autostart "no boot link S18tsem/K10tsem in $_rcd: after a reboot NOTHING installs the kill switch (fix: $_ini/tsem enable)"
		fi
	fi
	echo "selftest: $_st_f failed, $_st_w warnings"
	[ "$_st_f" -eq 0 ]
}

# Remove EVERY tsem rule (uninstall). Leaves tailscale alone. Internet becomes direct afterwards.
cmd_teardown() {
	lock_acquire
	be_guard_remove
	_rc=$?
	fo_reset
	lock_release
	return "$_rc"
}

# Adaptive polling. Fast only while something is unsettled; slow when everything is proven fine.
# Events (hardware switch via `tsem set`, hotplug ifup/ifdown, fw3 reload include) act immediately
# and do not wait for the next poll. Nothing polls the hardware switch.
#   direct (nothing to probe, only drift repair)        TSEM_INTERVAL_IDLE      default 60
#   german, primary active and healthy                  TSEM_INTERVAL_STEADY    default 20
#   german, secondary active and healthy (return check) TSEM_INTERVAL_RECOVERY  default 15
#   anything else (connecting, degraded, blocked, error) TSEM_INTERVAL          default 5
cmd_interval() {
	intent_read
	if [ $? -ne 0 ]; then echo "$TSEM_INTERVAL intent-invalid"; return 0; fi
	if [ "$I_MODE" = direct ]; then echo "$TSEM_INTERVAL_IDLE direct"; return 0; fi
	if [ "$I_MODE" = blocked ]; then echo "$TSEM_INTERVAL_IDLE blocked"; return 0; fi
	fo_load
	_ns=$(fo_state_name german)
	case $_ns in
	PRIMARY_ACTIVE) echo "$TSEM_INTERVAL_STEADY $_ns" ;;
	SECONDARY_ACTIVE) echo "$TSEM_INTERVAL_RECOVERY $_ns" ;;
	*) echo "$TSEM_INTERVAL $_ns" ;;
	esac
}

cmd_daemon() {
	log "daemon started (adaptive interval ${TSEM_INTERVAL}s..${TSEM_INTERVAL_IDLE}s)"
	while :; do
		# a fresh process per round: configuration changed through `tsem config set` (GUI/API) takes effect
		# without a restart, and a crashing round can never take the daemon down
		sh "$0" tick || true
		_di=$(sh "$0" interval)
		sleep "${_di%% *}"
	done
}

cmd_verify_nodes() {
	_vn_rc=0
	if [ -n "$TSEM_PRIMARY_NAME$TSEM_SECONDARY_NAME" ]; then
		be_nodes_scan >/dev/null 2>&1 || true
	fi
	for _vn in primary secondary; do
		_vip=$(node_of "$_vn")
		_vname=$(name_of "$_vn")
		if [ -z "$_vip" ]; then
			if [ "$_vn" = primary ]; then echo "FAIL primary: not configured"; _vn_rc=1; else echo "WARN secondary: not configured (no failover)"; fi
			continue
		fi
		_vwhy=$(be_node_why "$_vname" "$_vip")
		_vr=$?
		if [ "$_vr" -eq 0 ]; then
			case $_vwhy in
			*"NOT verified"*) echo "WARN $_vn: ${_vname:-<no name>} $_vip: $_vwhy" ;;
			*) echo "PASS $_vn: $_vname $_vip: $_vwhy" ;;
			esac
		else
			echo "FAIL $_vn: ${_vname:-<no name>} $_vip: $_vwhy"
			_vn_rc=1
		fi
	done
	return "$_vn_rc"
}

# ----------------------------------------------------------- configuration (GUI / API)

# Only these keys can be changed from outside; everything else stays an expert edit of tsem.conf.
_CFG_EDIT="TSEM_PRIMARY TSEM_PRIMARY_NAME TSEM_SECONDARY TSEM_SECONDARY_NAME TSEM_AUTO_RETURN TSEM_MODE_LABEL TSEM_ALLOW_SUBNETS4 TSEM_HW_AT_BOOT"

_cfg_valid() { # KEY VALUE
	case $1 in
	TSEM_PRIMARY) valid_ip4 "$2" ;;
	TSEM_SECONDARY) [ -z "$2" ] || valid_ip4 "$2" ;;
	TSEM_PRIMARY_NAME | TSEM_SECONDARY_NAME)
		case $2 in '') return 0 ;; *[!A-Za-z0-9.-]* | -* | .*) return 1 ;; esac
		[ "${#2}" -le 63 ] ;;
	TSEM_AUTO_RETURN) case $2 in 0 | 1) return 0 ;; *) return 1 ;; esac ;;
	TSEM_HW_AT_BOOT) case $2 in last | switch) return 0 ;; *) return 1 ;; esac ;;
	TSEM_MODE_LABEL) case $2 in '' | *[!A-Za-z0-9' '_-]*) return 1 ;; esac; [ "${#2}" -le 20 ] ;;
	# Networks the router may reach while BLOCKED (e.g. the LANs behind your exit nodes): at most 8 entries, each /16 or smaller.
	# A blanket release (/0 .. /15) would defeat the kill switch, so it is refused here (expert edit of tsem.conf only).
	TSEM_ALLOW_SUBNETS4)
		[ "${#2}" -le 200 ] || return 1
		_cv_n=0
		for _cv_c in $2; do
			valid_cidr4 "$_cv_c" || return 1
			[ "${_cv_c#*/}" -ge 16 ] || return 1
			_cv_n=$((_cv_n + 1))
		done
		[ "$_cv_n" -le 8 ] ;;
	*) return 1 ;;
	esac
}

cmd_config() {
	_cc_sub=${1:-}
	[ $# -gt 0 ] && shift
	case $_cc_sub in
	get)
		intent_read; _cc_irc=$?
		_cc_fo=unknown; [ "$_cc_irc" -ne 0 ] || _cc_fo=$I_FAILOVER
		if [ "${1:-}" = --json ]; then
			# read-only parameters (changing them is not offered by the API: they shape the kill switch and failover timing)
			_cc_n() { case $1 in '' | *[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }
			_cc_sub4=$(printf '%s' "${TSEM_ALLOW_SUBNETS4:-}" | tr -c '0-9./: ' ' ' | sed 's/  */ /g; s/^ //; s/ $//')
			printf '{"primary":"%s","primary_name":"%s","secondary":"%s","secondary_name":"%s","auto_return":%s,"failover":"%s","mode_label":"%s","hw_at_boot":"%s","params":{"interval":%s,"interval_recovery":%s,"fail_n":%s,"up_n":%s,"return_n":%s,"dwell":%s,"backoff_min":%s,"backoff_max":%s,"probe_timeout":%s,"allow_subnets4":"%s"}}\n' \
				"$TSEM_PRIMARY" "$TSEM_PRIMARY_NAME" "$TSEM_SECONDARY" "$TSEM_SECONDARY_NAME" "$([ "$TSEM_AUTO_RETURN" = 1 ] && echo true || echo false)" "$_cc_fo" "$TSEM_MODE_LABEL" "$TSEM_HW_AT_BOOT" \
				"$(_cc_n "$TSEM_INTERVAL")" "$(_cc_n "$TSEM_INTERVAL_RECOVERY")" "$(_cc_n "$TSEM_FAIL_N")" "$(_cc_n "$TSEM_UP_N")" "$(_cc_n "$TSEM_RETURN_N")" \
				"$(_cc_n "$TSEM_DWELL")" "$(_cc_n "$TSEM_BACKOFF_MIN")" "$(_cc_n "$TSEM_BACKOFF_MAX")" "$(_cc_n "$TSEM_PROBE_TIMEOUT")" "$_cc_sub4"
		else
			printf 'primary=%s\nprimary_name=%s\nsecondary=%s\nsecondary_name=%s\nauto_return=%s\nfailover=%s\n' \
				"$TSEM_PRIMARY" "$TSEM_PRIMARY_NAME" "$TSEM_SECONDARY" "$TSEM_SECONDARY_NAME" "$TSEM_AUTO_RETURN" "$_cc_fo"
		fi
		;;
	set)
		[ $# -ge 1 ] || die "usage: tsem config set KEY=VALUE ... (keys: $_CFG_EDIT)"
		_cc_np=$TSEM_PRIMARY _cc_ns=$TSEM_SECONDARY _cc_nodes=0 _cc_sub=0
		for _cc_a in "$@"; do
			case $_cc_a in *=*) ;; *) DIE_RC=2 die "expected KEY=VALUE, got '$(safe_word "$_cc_a")'" ;; esac
			_cc_k=${_cc_a%%=*} _cc_v=${_cc_a#*=}
			case " $_CFG_EDIT " in *" $_cc_k "*) ;; *) DIE_RC=2 die "key '$(safe_word "$_cc_k")' cannot be changed here" ;; esac
			_cfg_valid "$_cc_k" "$_cc_v" || DIE_RC=2 die "invalid value for $_cc_k"
			case $_cc_k in
			# only a REAL change restarts the verification / re-applies the rules (the GUI always sends every field)
			TSEM_PRIMARY) _cc_np=$_cc_v; [ "$_cc_v" = "$TSEM_PRIMARY" ] || _cc_nodes=1 ;;
			TSEM_SECONDARY) _cc_ns=$_cc_v; [ "$_cc_v" = "$TSEM_SECONDARY" ] || _cc_nodes=1 ;;
			TSEM_PRIMARY_NAME) [ "$_cc_v" = "$TSEM_PRIMARY_NAME" ] || _cc_nodes=1 ;;
			TSEM_SECONDARY_NAME) [ "$_cc_v" = "$TSEM_SECONDARY_NAME" ] || _cc_nodes=1 ;;
			TSEM_ALLOW_SUBNETS4) [ "$(printf '%s
' $_cc_v | sort | tr '
' ' ')" = "$(printf '%s
' ${TSEM_ALLOW_SUBNETS4:-} | sort | tr '
' ' ')" ] || _cc_sub=1 ;;
			esac
		done
		[ -n "$_cc_np" ] || DIE_RC=2 die "the primary exit node cannot be empty"
		[ -z "$_cc_ns" ] || [ "$_cc_ns" != "$_cc_np" ] || DIE_RC=2 die "primary and secondary must be different nodes"
		lock_acquire
		_cc_tmp=$TSEM_CONF.tsem-new.$$
		{ [ -f "$TSEM_CONF" ] && cat "$TSEM_CONF"; true; } >"$_cc_tmp" 2>/dev/null || { lock_release; die "cannot write configuration"; }
		for _cc_a in "$@"; do
			_cc_k=${_cc_a%%=*} _cc_v=${_cc_a#*=}
			awk -v k="$_cc_k" -v v="$_cc_v" 'BEGIN { d = 0 } index($0, k "=") == 1 && !d { print k "=" v; d = 1; next } { print } END { if (!d) print k "=" v }' "$_cc_tmp" >"$_cc_tmp.2" &&
				mv -f "$_cc_tmp.2" "$_cc_tmp" || { rm -f "$_cc_tmp" "$_cc_tmp.2"; lock_release; die "cannot write configuration"; }
		done
		[ ! -f "$TSEM_CONF" ] || cp -p "$TSEM_CONF" "$TSEM_CONF.bak" 2>/dev/null
		mv -f "$_cc_tmp" "$TSEM_CONF" || { rm -f "$_cc_tmp"; lock_release; die "cannot write configuration"; }
		# new exit nodes: the controller starts verifying from scratch; the guard stays closed meanwhile (never opens)
		[ "$_cc_nodes" -ne 1 ] || fo_reset
		# the released networks are part of the installed rules: re-apply the CURRENT guard with the new value now,
		# otherwise the file and the kernel disagree until the next mode change
		if [ "$_cc_sub" -eq 1 ]; then
			_cc_g=$(be_guard_get)
			case $_cc_g in
			german | blocked) ( conf_load; be_guard_set "$_cc_g" ) || { lock_release; die "saved, but the rules could not be re-applied (the guard stays as it was)"; } ;;
			esac
		fi
		lock_release
		log "config set: $*"
		echo "configuration saved"
		;;
	*) die "usage: tsem config get [--json] | config set KEY=VALUE ..." ;;
	esac
}

# nodes [--json]: the tailnet's exit-capable peers (read-only), marked with the role they have in the configuration.
cmd_nodes() {
	be_nodes_scan >/dev/null 2>&1 || { [ "${1:-}" = --json ] && echo '{"available":false,"nodes":[]}' || echo "unavailable"; return 1; }
	_nd_f=$TSEM_RUN_DIR/peers
	_nd_first=1
	[ "${1:-}" != --json ] || printf '{"available":true,"nodes":['
	while IFS='|' read -r _nd_h _nd_ips _nd_on _nd_ex _nd_dns; do
		[ -n "$_nd_h" ] || continue
		_nd_ip=${_nd_ips%%,*}
		_nd_role=none
		[ "$_nd_ip" != "$TSEM_PRIMARY" ] || _nd_role=primary
		[ "$_nd_ip" != "$TSEM_SECONDARY" ] || [ -z "$TSEM_SECONDARY" ] || _nd_role=secondary
		case "$_nd_on" in true | false) _nd_on_j=$_nd_on ;; *) _nd_on_j=null ;; esac # "unknown" (short peer form) is not "offline"
		if [ "${1:-}" = --json ]; then
			[ "$_nd_first" -eq 1 ] || printf ','
			printf '{"name":"%s","ip":"%s","online":%s,"exit_option":%s,"role":"%s"}' "$(safe_word "$_nd_h")" "$_nd_ip" "$_nd_on_j" "$_nd_ex" "$_nd_role"
			_nd_first=0
		else
			printf '%s %s online=%s exit=%s role=%s\n' "$(safe_word "$_nd_h")" "$_nd_ip" "$_nd_on" "$_nd_ex" "$_nd_role"
		fi
	done <"$_nd_f"
	[ "${1:-}" != --json ] || printf ']}\n'
	return 0
}

# subnets [--json]: networks that peers advertise to this router, plus the ones already allowed in the configuration,
# each marked allowed / selectable. Only /16 or smaller can be selected (a blanket release would defeat the kill switch).
cmd_subnets() {
	_sn_cfg=$(printf '%s' "${TSEM_ALLOW_SUBNETS4:-}" | tr -c '0-9./ ' ' ')
	_sn_all=$( { be_subnets_scan 2>/dev/null; printf '%s\n' $_sn_cfg; } | awk 'NF && !s[$1]++ { print $1 }')
	_sn_first=1
	[ "${1:-}" != --json ] || printf '{"available":true,"subnets":['
	for _sn in $_sn_all; do
		valid_cidr4 "$_sn" || continue
		_sn_al=false; case " $_sn_cfg " in *" $_sn "*) _sn_al=true ;; esac
		_sn_pr=false; be_subnets_scan 2>/dev/null | grep -qx "$_sn" && _sn_pr=true
		_sn_ed=true; [ "${_sn#*/}" -ge 16 ] || _sn_ed=false
		if [ "${1:-}" = --json ]; then
			[ "$_sn_first" -eq 1 ] || printf ','
			printf '{"cidr":"%s","allowed":%s,"present":%s,"selectable":%s}' "$_sn" "$_sn_al" "$_sn_pr" "$_sn_ed"
			_sn_first=0
		else
			printf '%s allowed=%s present=%s selectable=%s\n' "$_sn" "$_sn_al" "$_sn_pr" "$_sn_ed"
		fi
	done
	[ "${1:-}" != --json ] || printf ']}\n'
	return 0
}

# egress [--json] [--refresh]: the public address this router currently reaches the Internet with, asked from
# myip.wtf (the only external service TSEM ever contacts, and only when this is called, e.g. by the GUI button).
# Through an exit node this shows the exit node's address, in DIRECT mode the real one. The answer is untrusted text:
# every field is reduced to a safe character set and length. Cached 60 s in the run dir (5 s for --refresh).
cmd_egress() {
	_eg_j=0 _eg_r=0
	for _eg_a in "$@"; do case $_eg_a in --json) _eg_j=1 ;; --refresh) _eg_r=1 ;; esac; done
	_eg_f=$TSEM_RUN_DIR/egress
	_eg_now=$(now)
	_eg_out=''
	_eg_ttl=60; [ "$_eg_r" -eq 0 ] || _eg_ttl=5 # --refresh still answers from the cache within 5 s (no hammering of the service)
	if [ -f "$_eg_f" ]; then
		_eg_ts=$(sed -n 's/.*"ts":\([0-9]*\).*/\1/p' "$_eg_f" | head -n 1)
		[ -n "$_eg_ts" ] && [ $((_eg_now - _eg_ts)) -lt "$_eg_ttl" ] && [ $((_eg_now - _eg_ts)) -ge 0 ] && _eg_out=$(cat "$_eg_f")
	fi
	if [ -z "$_eg_out" ]; then
		_eg_raw=$(${TSEM_CURL:-curl} -s -m 8 --max-filesize 8192 "${TSEM_EGRESS_URL:-https://myip.wtf/json}" 2>/dev/null) || _eg_raw=''
		_eg_get() { printf '%s\n' "$_eg_raw" | sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" | head -n 1 | tr -cd 'A-Za-z0-9 .,:_()/-' | cut -c1-80; }
		_eg_ip=$(_eg_get YourFuckingIPAddress | tr -cd '0-9A-Fa-f.:')
		if [ -n "$_eg_ip" ]; then
			_eg_tor=false; printf '%s\n' "$_eg_raw" | grep -q '"YourFuckingTorExit": *true' && _eg_tor=true
			_eg_out=$(printf '{"ok":true,"ip":"%s","location":"%s","isp":"%s","country":"%s","country_code":"%s","hostname":"%s","tor":%s,"source":"myip.wtf","ts":%s}' \
				"$_eg_ip" "$(_eg_get YourFuckingLocation)" "$(_eg_get YourFuckingISP)" "$(_eg_get YourFuckingCountry)" "$(_eg_get YourFuckingCountryCode)" "$(_eg_get YourFuckingHostname)" "$_eg_tor" "$_eg_now")
			mkdir -p "$TSEM_RUN_DIR" 2>/dev/null; printf '%s\n' "$_eg_out" >"$_eg_f"
		else
			_eg_out='{"ok":false,"reason":"unreachable"}'
		fi
	fi
	if [ "$_eg_j" -eq 1 ]; then printf '%s\n' "$_eg_out"
	else
		case $_eg_out in
		*'"ok":true'*) for _eg_k in ip location isp country hostname; do printf '%s=%s\n' "$_eg_k" "$(printf '%s' "$_eg_out" | sed -n "s/.*\"$_eg_k\":\"\([^\"]*\)\".*/\1/p")"; done ;;
		*) echo "egress: the public address could not be determined (no Internet path, BLOCKED, or the service is unreachable)"; return 1 ;;
		esac
	fi
	return 0
}

# hw-probe: READ-ONLY survey of everything that could tell where the hardware switch is and how the firmware
# reports it (F04). Changes nothing; used once on the router to decide whether a position reader can be configured.
cmd_hw_probe() {
	echo "== tsem hw-probe (read-only)"
	echo "-- hook files"
	ls -l /etc/gl-switch.d/ 2>&1 | head -n 20
	echo "-- firmware setting for the toggle button"
	if command -v uci >/dev/null 2>&1; then uci -q show switch-button 2>&1 | head -n 12; else echo "(no uci)"; fi
	echo "-- firmware handlers"
	ls -l /etc/rc.button /etc/hotplug.d/button /etc/hotplug.d/switch 2>&1 | head -n 20
	echo "-- input devices that look like a switch or button"
	grep -iE -B1 -A6 'switch|button|gpio-keys' /proc/bus/input/devices 2>/dev/null | head -n 40
	echo "-- exported sysfs gpio (direction, value)"
	for _g in /sys/class/gpio/gpio*; do
		[ -d "$_g" ] || continue
		echo "$_g direction=$(cat "$_g/direction" 2>/dev/null) value=$(cat "$_g/value" 2>/dev/null)"
	done
	echo "-- debugfs gpio lines mentioning a switch (only if debugfs is already mounted)"
	grep -iE 'switch|button|mode|sw[0-9_ -]' /sys/kernel/debug/gpio 2>/dev/null | head -n 10
	echo "-- what tsem knows (event since boot / persisted before boot)"
	cat "$TSEM_RUN_DIR/hw_event" 2>/dev/null || echo "(no event since boot)"
	cat "$TSEM_STATE_DIR/hw_last" 2>/dev/null || echo "(no persisted event)"
	echo "-- configured readers"
	echo "TSEM_HW_GPIO_VALUE=${TSEM_HW_GPIO_VALUE:-} TSEM_HW_GPIO_ON=${TSEM_HW_GPIO_ON:-} TSEM_HW_STATE_FILE=${TSEM_HW_STATE_FILE:-}"
	return 0
}

# ------------------------------------------------------------------ main

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
set) cmd_set "$@" ;;
failover) cmd_failover "$@" ;;
status) cmd_status "$@" ;;
tick) cmd_tick ;;
daemon) cmd_daemon ;;
boot) cmd_boot ;;
reapply) cmd_reapply ;;
deps) cmd_deps ;;
teardown) cmd_teardown ;;
diag) cmd_diag ;;
selftest) cmd_selftest ;;
verify-nodes) cmd_verify_nodes ;;
config) cmd_config "$@" ;;
nodes) cmd_nodes "$@" ;;
subnets) cmd_subnets "$@" ;;
egress) cmd_egress "$@" ;;
interval) cmd_interval ;;
intent-check) cmd_intent_check ;;
hw-probe) cmd_hw_probe ;;
hw-policy) printf '%s\n' "${TSEM_HW_AT_BOOT:-last}" ;;
version) echo "$TSEM_VERSION" ;;
*)
	echo "usage: tsem set direct|german [--source NAME] [--no-wait] | failover auto|off|now | status [--json] | tick | daemon | boot | reapply | teardown | verify-nodes | config get|set | nodes [--json] | interval | intent-check | hw-probe | hw-policy | diag | selftest" >&2
	exit 2
	;;
esac
