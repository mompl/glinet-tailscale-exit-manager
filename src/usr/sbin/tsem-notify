#!/bin/sh
# tsem-notify - sends a short message when tsem changes state (ntfy or a generic webhook), without Home Assistant.
#
#   tsem-notify tick OLD NEW    called by the controller after a tick: queues an event if the state changed, then sends the queue
#   tsem-notify test            sends a test message now (prints what happened)
#   tsem-notify queue           shows what is waiting to be sent
#   tsem-notify report TEXT     sends a one-line report (used by 'tsem report --notify'; it does not depend on NOTIFY_EVENTS)
#
# It only talks to the notification URL; it never touches firewall rules, routes or tailscale, and the controller never waits for it.
# While the kill switch is closed the Internet is not reachable, so a BLOCKED message waits in a queue (tmpfs, at most 20 lines) and
# is sent with its ORIGINAL time as soon as a destination is reachable again. A notification server on your tailnet (tailscale0 stays
# open) is reachable even in BLOCKED, see docs/rc/notifications.md.
#
# Config: /etc/tsem/notify.conf (not installed by default; see notify.conf.example). Values are validated; unsafe ones are ignored.

set -u
umask 077
NOTIFY_CONF=${TSEM_NOTIFY_CONF:-/etc/tsem/notify.conf}
RUN=${TSEM_RUN_DIR:-/var/run/tsem}
TSEM_BIN=${TSEM_BIN:-/usr/sbin/tsem}
CURL=${TSEM_CURL:-curl}
Q=$RUN/notify.queue
LOCK=$RUN/notify.lock

lg() { printf 'tsem-notify: %s\n' "$*" >&2; command -v logger >/dev/null 2>&1 && [ "${TSEM_SYSLOG:-1}" = 1 ] && logger -t tsem-notify -- "$*"; return 0; }

N_TYPE=ntfy N_URL='' N_URL2='' N_NAME='' N_EVENTS='failover blocked recovered' N_TOKENFILE='' N_TOKENFILE2='' N_PRIO_BLOCKED=urgent
load_conf() {
	[ -r "$NOTIFY_CONF" ] || return 1
	while IFS= read -r l || [ -n "$l" ]; do
		case $l in '' | '#'* | ' '*) continue ;; esac
		k=${l%%=*}
		v=${l#*=}
		case $v in \"*\") v=${v#\"}; v=${v%\"} ;; esac
		case $k in
		NOTIFY_TYPE) case $v in ntfy | webhook) N_TYPE=$v ;; *) lg "bad $k" ;; esac ;;
		NOTIFY_URL) case $v in http://* | https://*) case $v in *[!A-Za-z0-9./:_?=\&%@+-]*) lg "bad $k" ;; *) N_URL=$v ;; esac ;; *) lg "bad $k" ;; esac ;;
		NOTIFY_URL_FALLBACK) case $v in http://* | https://*) case $v in *[!A-Za-z0-9./:_?=\&%@+-]*) lg "bad $k" ;; *) N_URL2=$v ;; esac ;; *) lg "bad $k" ;; esac ;;
		NOTIFY_NAME) case $v in '' | *[!A-Za-z0-9._-]*) lg "bad $k" ;; *) N_NAME=$v ;; esac ;;
		NOTIFY_EVENTS) case $v in *[!a-z\ ]*) lg "bad $k" ;; *) N_EVENTS=$v ;; esac ;;
		NOTIFY_TOKEN_FILE) case $v in /*) case $v in *[!A-Za-z0-9./_-]*) lg "bad $k" ;; *) N_TOKENFILE=$v ;; esac ;; *) lg "bad $k" ;; esac ;;
		NOTIFY_TOKEN_FILE_FALLBACK) case $v in /*) case $v in *[!A-Za-z0-9./_-]*) lg "bad $k" ;; *) N_TOKENFILE2=$v ;; esac ;; *) lg "bad $k" ;; esac ;;
		*) lg "unknown key $k ignored" ;;
		esac
	done <"$NOTIFY_CONF"
	[ -n "$N_URL" ] || { lg "no valid NOTIFY_URL in $NOTIFY_CONF"; return 1; }
	[ -n "$N_NAME" ] || N_NAME=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo router)
	return 0
}

status_field() { "$TSEM_BIN" status 2>/dev/null | sed -n "s/^$1=//p" | head -n1 | tr -cd 'A-Za-z0-9._ -'; }

# event for a state change: prints event name, or nothing
event_of() { # old new
	case $2 in
	SECONDARY_ACTIVE) echo failover ;;
	BLOCKED) echo blocked ;;
	PRIMARY_ACTIVE)
		case $1 in SECONDARY_ACTIVE | BLOCKED | CONNECTING_SECONDARY | DEGRADED | ERROR) echo recovered ;; *) echo exit ;; esac ;;
	DISABLED) echo direct ;;
	ERROR) echo error ;;
	esac
}

text_of() { # event
	_lab=$(status_field mode_label); [ -n "$_lab" ] || _lab=EXIT
	_an=$(status_field active_exit_name)
	case $1 in
	failover) echo "$N_NAME: the backup exit node took over${_an:+ ($_an)}. $_lab keeps working." ;;
	blocked) echo "$N_NAME: BLOCKED. No usable exit node; the network is cut on purpose (no leak)." ;;
	recovered) echo "$N_NAME: back on the primary exit node${_an:+ ($_an)}." ;;
	exit) echo "$N_NAME: $_lab is active${_an:+ via $_an}." ;;
	direct) echo "$N_NAME: DIRECT. Normal internet, the kill switch is off." ;;
	error) echo "$N_NAME: the controller reports an ERROR. Check tsem status." ;;
	test) echo "$N_NAME: test message from tsem-notify." ;;
	*) echo "$N_NAME: $1" ;;
	esac
}

prio_of() { case $1 in blocked | error) echo urgent ;; failover) echo high ;; *) echo default ;; esac; }
tag_of() { case $1 in report) echo bar_chart ;; blocked) echo rotating_light ;; failover) echo warning ;; recovered | exit) echo white_check_mark ;; direct) echo unlock ;; error) echo x ;; *) echo information_source ;; esac; }

send_one() { # epoch event text -> 0 sent
	_ts=$1 _ev=$2 _tx=$3
	command -v "$CURL" >/dev/null 2>&1 || { lg "curl is not installed"; return 1; }
	_when=$(date -d "@$_ts" '+%H:%M:%S' 2>/dev/null || date -r "$_ts" '+%H:%M:%S' 2>/dev/null || echo "")
	[ -z "$_when" ] || _tx="$_tx (event time $_when)"
	if [ "$N_TYPE" = ntfy ]; then
		_body=$_tx
	else
		_body=$(printf '{"router":"%s","event":"%s","time":%s,"message":"%s"}' "$N_NAME" "$_ev" "$_ts" "$(printf '%s' "$_tx" | tr -d '"\\')")
	fi
	send_to "$N_URL" "$N_TOKENFILE" && return 0
	# the main address (normally the public one) did not work, for example in BLOCKED: try the second one (a server on the tailnet or in the LAN)
	[ -n "$N_URL2" ] || return 1
	send_to "$N_URL2" "${N_TOKENFILE2:-$N_TOKENFILE}"
}

# one request to one address; every address can have its own access token. Uses $_ev and $_body of send_one.
host_of() { _h=${1#*://}; echo "${_h%%/*}"; }

send_to() { # url tokenfile
	_used=$1
	_cfg=$RUN/notify.curl
	: >"$_cfg"
	if [ -n "$2" ] && [ -r "$2" ]; then
		printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '\r\n"' <"$2")" >>"$_cfg"
	fi
	if [ "$N_TYPE" = ntfy ]; then
		printf 'header = "Title: tsem %s"\nheader = "Priority: %s"\nheader = "Tags: %s"\n' "$_ev" "$(prio_of "$_ev")" "$(tag_of "$_ev")" >>"$_cfg"
	else
		printf 'header = "Content-Type: application/json"\n' >>"$_cfg"
	fi
	"$CURL" -s -f -m 10 -K "$_cfg" -d "$_body" "$1" >/dev/null 2>&1
	_rc=$?
	rm -f "$_cfg"
	return $_rc
}

flush() {
	[ -s "$Q" ] || return 0
	_left=$RUN/notify.left
	: >"$_left"
	_stop=0
	while IFS='|' read -r ts ev tx || [ -n "$ts" ]; do
		[ -n "$ts" ] || continue
		if [ "$_stop" = 1 ]; then printf '%s|%s|%s\n' "$ts" "$ev" "$tx" >>"$_left"; continue; fi
		if send_one "$ts" "$ev" "$tx"; then :; else _stop=1; printf '%s|%s|%s\n' "$ts" "$ev" "$tx" >>"$_left"; fi
	done <"$Q"
	tail -n 20 "$_left" >"$Q"
	rm -f "$_left"
	[ -s "$Q" ] || rm -f "$Q"
}

enqueue() { # event
	case " $N_EVENTS " in *" $1 "*) ;; *) return 0 ;; esac
	printf '%s|%s|%s\n' "$(date +%s)" "$1" "$(text_of "$1")" >>"$Q"
}

with_lock() {
	mkdir -p "$RUN"
	_i=0
	while ! mkdir "$LOCK" 2>/dev/null; do
		_i=$((_i + 1))
		[ "$_i" -le 30 ] || { [ -n "$(find "$LOCK" -mmin +2 2>/dev/null)" ] && rmdir "$LOCK" 2>/dev/null; return 1; }
		sleep 1
	done
	trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
	"$@"
}

case ${1:-} in
tick)
	[ $# -ge 3 ] || exit 2
	load_conf || exit 0
	_ev=$(event_of "$2" "$3")
	run_tick() { [ "$2" = "$3" ] || { [ -z "$_ev" ] || enqueue "$_ev"; }; flush; }
	with_lock run_tick "$@"
	;;
test)
	load_conf || { echo "tsem-notify: no usable $NOTIFY_CONF"; exit 1; }
	# only the server name is printed: on a public server the topic is a secret
	if send_one "$(date +%s)" test "$(text_of test)"; then echo "tsem-notify: sent via $(host_of "$_used")"; else echo "tsem-notify: could not send (tried $(host_of "$N_URL")${N_URL2:+ and $(host_of "$N_URL2")})"; exit 1; fi
	;;
queue)
	[ -s "$Q" ] && cat "$Q" || echo "(empty)"
	;;
report)
	[ -n "${2:-}" ] || exit 2
	load_conf || exit 0
	_rtx=$(printf '%s' "$2" | tr -d '|\\\\"' | tr -cd ' -~' | cut -c1-300)
	run_report() { printf '%s|report|%s: %s\n' "$(date +%s)" "$N_NAME" "$_rtx" >>"$Q"; flush; }
	with_lock run_report
	;;
show)
	# what is configured, without secrets: on a public server the topic name acts like a password, so it is masked
	if [ "${2:-}" = --json ]; then
		if [ -r "$NOTIFY_CONF" ] && load_conf 2>/dev/null; then
			_tk() { [ -n "$1" ] && [ -r "$1" ] && echo true || echo false; }
			printf '{"configured":true,"type":"%s","name":"%s","server":"%s","token":%s,"fallback_server":"%s","fallback_token":%s,"events":"%s"}\n' "$N_TYPE" "$N_NAME" "$(host_of "$N_URL")" "$(_tk "$N_TOKENFILE")" "$([ -z "$N_URL2" ] || host_of "$N_URL2")" "$(_tk "${N_TOKENFILE2:-$N_TOKENFILE}")" "$N_EVENTS"
		else
			echo '{"configured":false}'
		fi
		exit 0
	fi
	[ -r "$NOTIFY_CONF" ] || { echo "no notification is configured ($NOTIFY_CONF)"; exit 0; }
	load_conf || exit 1
	_host() { host_of "$1"; }
	_has() { [ -n "$1" ] && [ -r "$1" ] && echo yes || echo no; }
	echo "type: $N_TYPE"
	echo "name: $N_NAME"
	echo "main: $(_host "$N_URL")  (topic hidden)  token: $(_has "$N_TOKENFILE")"
	[ -z "$N_URL2" ] || echo "fallback: $(_host "$N_URL2")  (topic hidden)  token: $(_has "${N_TOKENFILE2:-$N_TOKENFILE}")"
	echo "events: $N_EVENTS"
	;;
token)
	# stores an access token from standard input (never as an argument, so it stays out of the shell history and the process list)
	_tf=${2:-/etc/tsem/notify.token}
	case $_tf in /*) case $_tf in *[!A-Za-z0-9./_-]*) echo "tsem-notify: unsafe file name" >&2; exit 2 ;; esac ;; *) echo "tsem-notify: the file must be an absolute path" >&2; exit 2 ;; esac
	IFS= read -r _tok || true
	_tok=$(printf '%s' "$_tok" | tr -d ' \r\n\t')
	case $_tok in '' | *[!A-Za-z0-9._-]*) echo "tsem-notify: the token is empty or has unusual characters; nothing was written" >&2; exit 2 ;; esac
	( umask 077; printf '%s\n' "$_tok" >"$_tf.new" ) && mv "$_tf.new" "$_tf" && chmod 600 "$_tf" && echo "tsem-notify: token stored in $_tf (mode 600)"
	;;
setup)
	shift
	_srv='' _top='' _tkf='' _fsrv='' _ftop='' _ftkf='' _nm='' _evs='' _pub=0 _typ=ntfy
	while [ $# -gt 0 ]; do
		case $1 in
		--server) _srv=${2:-}; shift 2 ;;
		--topic) _top=${2:-}; shift 2 ;;
		--token-file) _tkf=${2:-}; shift 2 ;;
		--fallback-server) _fsrv=${2:-}; shift 2 ;;
		--fallback-topic) _ftop=${2:-}; shift 2 ;;
		--fallback-token-file) _ftkf=${2:-}; shift 2 ;;
		--name) _nm=${2:-}; shift 2 ;;
		--events) _evs=${2:-}; shift 2 ;;
		--public) _pub=1; shift ;;
		--webhook) _typ=webhook; shift ;;
		*) echo "tsem-notify setup: unknown option $1" >&2; exit 2 ;;
		esac
	done
	if [ "$_pub" = 1 ]; then
		[ -z "$_srv" ] || { echo "tsem-notify setup: --public and --server exclude each other" >&2; exit 2; }
		_srv=https://ntfy.sh
		[ -n "$_top" ] || _top=tsem-$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c 24)
		case $_top in tsem-) echo "tsem-notify setup: could not create a random topic" >&2; exit 1 ;; esac
	fi
	[ -n "$_srv" ] || { echo "usage: tsem-notify setup (--public | --server URL [--topic NAME]) [--token-file F] [--fallback-server URL [--fallback-topic NAME] [--fallback-token-file F]] [--name N] [--events 'a b'] [--webhook]" >&2; exit 2; }
	_ok_url() { case $1 in http://* | https://*) case $1 in *[!A-Za-z0-9./:_?=\&%@+-]*) return 1 ;; *) return 0 ;; esac ;; *) return 1 ;; esac; }
	_ok_top() { case $1 in '' | *[!A-Za-z0-9_-]*) return 1 ;; *) return 0 ;; esac; }
	_ok_file() { case $1 in '') return 0 ;; /*) case $1 in *[!A-Za-z0-9./_-]*) return 1 ;; *) return 0 ;; esac ;; *) return 1 ;; esac; }
	_ok_url "$_srv" || { echo "tsem-notify setup: --server must be an http(s) address without unusual characters" >&2; exit 2; }
	if [ "$_typ" = ntfy ]; then
		_ok_top "$_top" || { echo "tsem-notify setup: --topic is required for ntfy (letters, digits, - and _)" >&2; exit 2; }
		_url=${_srv%/}/$_top
	else
		_url=$_srv
	fi
	_url2=''
	if [ -n "$_fsrv" ]; then
		_ok_url "$_fsrv" || { echo "tsem-notify setup: --fallback-server is not a valid http(s) address" >&2; exit 2; }
		if [ "$_typ" = ntfy ]; then
			_ftop=${_ftop:-$_top}
			_ok_top "$_ftop" || { echo "tsem-notify setup: --fallback-topic is not valid" >&2; exit 2; }
			_url2=${_fsrv%/}/$_ftop
		else
			_url2=$_fsrv
		fi
	fi
	_ok_file "$_tkf" && _ok_file "$_ftkf" || { echo "tsem-notify setup: token files must be absolute paths" >&2; exit 2; }
	case $_nm in '' | *[!A-Za-z0-9._-]*) [ -z "$_nm" ] || { echo "tsem-notify setup: --name has unusual characters" >&2; exit 2; } ;; esac
	case $_evs in *[!a-z\ ]*) echo "tsem-notify setup: --events must be words like: failover blocked recovered exit direct error" >&2; exit 2 ;; esac
	_new=$NOTIFY_CONF.new
	(
		umask 077
		{
			echo "# written by 'tsem-notify setup'"
			echo "NOTIFY_TYPE=$_typ"
			echo "NOTIFY_URL=$_url"
			[ -z "$_url2" ] || echo "NOTIFY_URL_FALLBACK=$_url2"
			[ -z "$_nm" ] || echo "NOTIFY_NAME=$_nm"
			[ -z "$_evs" ] || echo "NOTIFY_EVENTS=\"$_evs\""
			[ -z "$_tkf" ] || echo "NOTIFY_TOKEN_FILE=$_tkf"
			[ -z "$_ftkf" ] || echo "NOTIFY_TOKEN_FILE_FALLBACK=$_ftkf"
		} >"$_new"
	) && mv "$_new" "$NOTIFY_CONF" && chmod 600 "$NOTIFY_CONF" || { rm -f "$_new"; echo "tsem-notify setup: could not write $NOTIFY_CONF" >&2; exit 1; }
	echo "tsem-notify: saved $NOTIFY_CONF (mode 600)"
	if [ "$_pub" = 1 ]; then
		echo "NOTE: ntfy.sh is a public server. Anyone who knows the topic can read the messages and send fake ones, and the text passes through that server."
		echo "      The topic works like a password: $_top"
		echo "      Subscribe to exactly this topic in the ntfy app. For a private server use --server instead. Test: tsem-notify test"
	fi
	;;
*)
	echo "usage: tsem-notify tick OLD NEW | test | queue | show | setup ... | token [FILE]" >&2
	exit 2
	;;
esac
