#!/bin/sh
# rpcd exec plugin: ubus object "tsem". THE local API of the GL.iNet Tailscale Exit Manager.
#
# No daemon of its own: rpcd runs this on demand. Authentication and authorization are rpcd's
# (ubus session + ACL, /usr/share/rpcd/acl.d/tsem.json): reading needs "read", every change needs
# "write". This script contains no security logic of its own beyond strict input validation.
# It calls the one controller (`tsem`); it never touches firewall rules or tailscale itself.
#
# Reachable like every ubus object through LuCI/GL.iNet's uhttpd (/ubus), which listens on the LAN
# only. The installer never opens a WAN port for it.
#
#   ubus call tsem status        read   controller state (JSON of `tsem status --json`)
#   ubus call tsem config_get    read   exit nodes, auto-return, failover policy
#   ubus call tsem nodes         read   exit-capable tailnet peers
#   ubus call tsem events        read   recent tsem log lines
#   ubus call tsem diag          read   `tsem diag` output
#   ubus call tsem set_mode      write  {"mode":"german|direct|blocked","source":"gui|ha|api","confirm":true (direct only)}
#   ubus call tsem set_failover  write  {"mode":"auto|off","source":...}
#   ubus call tsem failover_now  write  manual failover to the other exit node
#   ubus call tsem config_set    write  {"nodes","node_names","primary","primary_name","secondary","secondary_name","auto_return"}
#
# Every reply is one JSON object with "ok". On errors: "error" (message) and "code" (see below).
# Replies to changes carry "requested" and the status read AFTER the change ("status"), so a
# client shows what was REACHED, never just what was asked for.

PATH=${PATH:+$PATH:}/usr/sbin:/usr/bin:/sbin:/bin; export PATH
TSEM_BIN=${TSEM_BIN:-/usr/sbin/tsem}
TSEM_LOGREAD=${TSEM_LOGREAD:-logread}
TSEM_API_LINES=${TSEM_API_LINES:-120}

TAB=$(printf '\t')
# awk's gsub() treats backslashes in the replacement differently in gawk, mawk and busybox awk: escaping is done with sed
_je() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g"; }

jesc() { # stdin -> JSON-escaped, newline-joined with \n (control chars dropped)
	tr -d '\000-\010\013-\037' | _je | awk 'BEGIN { ORS = "" } { if (NR > 1) printf "%s", "\\n"; printf "%s", $0 }'
}

reply_err() { # code message
	printf '{"ok":false,"code":"%s","error":"%s"}\n' "$1" "$(printf '%s' "$2" | jesc)"
	exit 0
}

# lines_json: stdin lines -> JSON array of strings
lines_json() {
	printf '['
	tr -d '\000-\010\013-\037' | _je | awk 'BEGIN { first = 1 } { if (!first) printf ","; printf "\"%s\"", $0; first = 0 }'
	printf ']'
}

INPUT=
arg() { # name -> value of a string/bool/number field ("" if absent); validated by the caller
	[ -n "$INPUT" ] || return 0
	jsonfilter -s "$INPUT" -e "@.$1" 2>/dev/null
}

# sets SRC (no subshell: reply_err must be able to end the script)
src_arg() {
	SRC=$(arg source)
	case $SRC in '') SRC=api ;; gui | ha | api) ;; *) reply_err invalid_argument "source must be gui, ha or api" ;; esac
}

status_json() {
	_j=$("$TSEM_BIN" status --json 2>/dev/null)
	case $_j in '{'*'}') printf '%s' "$_j" ;; *) printf 'null' ;; esac
}

do_status() { printf '{"ok":true,"status":%s}\n' "$(status_json)"; }

do_config_get() {
	_j=$("$TSEM_BIN" config get --json 2>/dev/null)
	case $_j in '{'*'}') printf '{"ok":true,"config":%s}\n' "$_j" ;; *) reply_err backend "cannot read configuration" ;; esac
}

do_nodes() {
	_j=$("$TSEM_BIN" nodes --json 2>/dev/null)
	case $_j in '{'*'}') printf '{"ok":true,"result":%s}\n' "$_j" ;; *) printf '{"ok":true,"result":{"available":false,"nodes":[]}}\n' ;; esac
}

do_subnets() {
	_j=$("$TSEM_BIN" subnets --json 2>/dev/null)
	case $_j in '{'*'}') printf '{"ok":true,"result":%s}\n' "$_j" ;; *) printf '{"ok":true,"result":{"available":false,"subnets":[]}}\n' ;; esac
}

do_egress() {
	_j=$("$TSEM_BIN" egress --json --refresh 2>/dev/null)
	case $_j in '{'*'}') printf '{"ok":true,"result":%s}\n' "$_j" ;; *) printf '{"ok":true,"result":{"ok":false,"reason":"unavailable"}}\n' ;; esac
}

do_events() {
	_n=$TSEM_API_LINES
	_ev=$($TSEM_LOGREAD -e tsem 2>/dev/null | tail -n "$_n" | lines_json)
	printf '{"ok":true,"events":%s}\n' "${_ev:-[]}"
}

do_diag() {
	_dg=$("$TSEM_BIN" diag 2>&1 | tail -n 300 | lines_json)
	printf '{"ok":true,"diag":%s}\n' "${_dg:-[]}"
}

# result of a write: requested + the status AFTER the change (never an invented success)
write_reply() { # requested rc output
	if [ "$2" -eq 0 ]; then _ok=true; else _ok=false; fi
	printf '{"ok":%s,"requested":"%s","rc":%s,"message":"%s","status":%s}\n' "$_ok" "$1" "$2" "$(printf '%s' "$3" | tail -n 3 | jesc)" "$(status_json)"
}

do_set_mode() {
	_m=$(arg mode)
	case $_m in german | direct | blocked) ;; *) reply_err invalid_argument "mode must be german, direct or blocked" ;; esac
	src_arg
	if [ "$_m" = direct ]; then
		[ "$(arg confirm)" = 1 ] || [ "$(arg confirm)" = true ] ||
			reply_err confirmation_required "DIRECT switches the kill switch off; send confirm=true"
	fi
	_o=$("$TSEM_BIN" set "$_m" --source "$SRC" 2>&1)
	write_reply "$_m" $? "$_o"
}

do_set_failover() {
	_m=$(arg mode)
	case $_m in auto | off) ;; *) reply_err invalid_argument "mode must be auto or off" ;; esac
	src_arg
	_o=$("$TSEM_BIN" failover "$_m" --source "$SRC" 2>&1)
	write_reply "failover_$_m" $? "$_o"
}

do_failover_now() {
	_o=$("$TSEM_BIN" failover now 2>&1)
	_rc=$?
	case $_o in *"other node is not available"*) _rc=4 ;; esac
	if [ "$_rc" -eq 4 ]; then
		printf '{"ok":false,"code":"refused","error":"the other exit node is not available","requested":"failover_now","status":%s}\n' "$(status_json)"
		return 0
	fi
	write_reply failover_now "$_rc" "$_o"
}

do_config_set() {
	set --
	for _k in nodes node_names primary primary_name secondary secondary_name auto_return mode_label allow_subnets4 hw_at_boot; do
		# a key that is present (even empty) is a change; jsonfilter prints nothing for absent keys
		_present=$(jsonfilter -s "$INPUT" -t "@.$_k" 2>/dev/null)
		[ -n "$_present" ] || continue
		_v=$(arg "$_k")
		case $_k in
		auto_return) case $_v in 1 | true) _v=1 ;; 0 | false) _v=0 ;; *) reply_err invalid_argument "auto_return must be true or false" ;; esac ;;
		esac
		_key=$(printf 'TSEM_%s' "$_k" | tr 'a-z' 'A-Z')
		set -- "$@" "$_key=$_v"
	done
	[ $# -gt 0 ] || reply_err invalid_argument "nothing to change"
	_o=$("$TSEM_BIN" config set "$@" 2>&1)
	_rc=$?
	if [ "$_rc" -ne 0 ]; then
		reply_err invalid_argument "$(printf '%s' "$_o" | tail -n 1)"
	fi
	_j=$("$TSEM_BIN" config get --json 2>/dev/null)
	printf '{"ok":true,"requested":"config_set","config":%s,"status":%s}\n' "${_j:-null}" "$(status_json)"
}

case ${1:-} in
list)
	cat <<'JSON'
{"status":{},"config_get":{},"nodes":{},"subnets":{},"egress":{},"events":{},"diag":{},
"set_mode":{"mode":"string","source":"string","confirm":true},
"set_failover":{"mode":"string","source":"string"},
"failover_now":{},
"config_set":{"nodes":"string","node_names":"string","primary":"string","primary_name":"string","secondary":"string","secondary_name":"string","auto_return":true,"mode_label":"string","allow_subnets4":"string","hw_at_boot":"string"}}
JSON
	;;
call)
	INPUT=$(cat)
	[ -n "$INPUT" ] || INPUT='{}'
	[ -x "$TSEM_BIN" ] || reply_err backend "controller not installed"
	case ${2:-} in
	status) do_status ;;
	config_get) do_config_get ;;
	nodes) do_nodes ;;
	subnets) do_subnets ;;
	egress) do_egress ;;
	events) do_events ;;
	diag) do_diag ;;
	set_mode) do_set_mode ;;
	set_failover) do_set_failover ;;
	failover_now) do_failover_now ;;
	config_set) do_config_set ;;
	*) reply_err not_found "unknown method" ;;
	esac
	;;
*) echo "usage: $0 list | call METHOD (JSON on stdin)" >&2; exit 2 ;;
esac
