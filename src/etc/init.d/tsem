#!/bin/sh /etc/rc.common
# GL.iNet Tailscale Exit Manager.
# START=18 runs BEFORE firewall (19) and network (20): the fail-closed state is in
# place before any LAN traffic can be forwarded. Stopping this service does NOT
# open the kill switch; use `tsem set direct` (or the uninstaller) for that.

START=18
STOP=10
USE_PROCD=1

# Install the protection BEFORE firewall (19) and network (20) come up. Retried for a short
# time because kernel modules / xtables may not be ready on the very first try. START order is
# sequential: later services wait for this function. If it still fails, the daemon keeps
# retrying; `tsem status` reports ERROR + leak_risk meanwhile and layer 1 (policy routing)
# may already be active.
boot_guard() {
	_bn=0
	while ! ${TSEM_BIN:-/usr/sbin/tsem} boot; do
		_bn=$((_bn + 1))
		if [ "$_bn" -ge "${TSEM_BOOT_TRIES:-10}" ]; then
			logger -t tsem "boot: could not install the protection after $_bn tries (check 'tsem diag')"
			return 1
		fi
		sleep "${TSEM_BOOT_RETRY_DELAY:-1}"
	done
	return 0
}

start_service() {
	# Fail-closed state from the persisted intent. No probes, no tailscale calls.
	# A failed protection setup is never ignored silently: it is logged as critical and recorded in
	# /var/run/tsem/boot_failed (shown by `tsem status` as boot_failed=yes + leak_risk) until a later
	# apply succeeds. The daemon is started anyway because it keeps retrying; nothing is ever opened.
	if ! boot_guard; then
		logger -p daemon.crit -t tsem "CRITICAL: boot protection NOT installed; daemon will keep retrying (tsem status, tsem diag)"
		mkdir -p /var/run/tsem 2>/dev/null
		date +%s >/var/run/tsem/boot_failed 2>/dev/null
	fi
	# packages that setup installed and a firmware upgrade removed (ip6tables): reinstall in the background once the Internet is up
	( /usr/sbin/tsem deps >/dev/null 2>&1 & )
	procd_open_instance
	procd_set_param command /usr/sbin/tsem daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	if [ -x /usr/sbin/tsem-mqtt ] && [ -r /etc/tsem/mqtt.conf ]; then
		procd_open_instance mqtt
		procd_set_param command /usr/sbin/tsem-mqtt
		procd_set_param respawn 3600 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger tsem
}
