#!/usr/bin/env python3
# Test stand-in for OpenWrt's jsonfilter: supports  -s JSON -e @.key  and  -s JSON -t @.key  (flat keys only).
import sys, json
a = sys.argv[1:]
src = None; mode = None; expr = None
i = 0
while i < len(a):
    if a[i] == '-s': src = a[i+1]; i += 2
    elif a[i] in ('-e', '-t'): mode = a[i]; expr = a[i+1]; i += 2
    else: i += 1
try:
    d = json.loads(src)
except Exception:
    sys.exit(1)
if not expr or not expr.startswith('@.') or not isinstance(d, dict) or expr[2:] not in d:
    sys.exit(0)
v = d[expr[2:]]
if mode == '-t':
    t = {bool: 'boolean', int: 'int', float: 'double', str: 'string', dict: 'object', list: 'array', type(None): 'null'}[type(v)]
    print(t)
else:
    if isinstance(v, bool): print('true' if v else 'false')
    elif isinstance(v, (dict, list)): print(json.dumps(v))
    elif v is None: pass
    else: print(v)
